    {
        "id": "1ca390b0a270c727",
        "type": "ui_template",
        "z": "5306dc40c5a9c0a0",
        "group": "32cff3294d8faf26",
        "name": "Widget Configuracion",
        "order": 4,
        "width": 0,
        "height": 0,
        "format": "<div ng-if=\"msg\">\n    <h3> Configuración </h3>\n    <table width=\"100%\">\n        <tr>\n            <td><b>Umbral</b></td>\n            <td>{{msg.payload.umbral_mm}} mm</td>\n        </tr>\n        <tr>\n            <td><b>Muestreo</b></td>\n            <td>{{msg.payload.tiempo_muestreo_s}} s</td>\n        </tr>\n        <tr>\n            <td><b>Sensores</b></td>\n            <td>{{msg.payload.cantidad_sensores}}</td>\n        </tr>\n        <tr>\n            <td><b>Email alertas</b></td>\n            <td>{{msg.payload.email_alertas}}</td>\n        </tr>\n        <tr>\n            <td><b>Sistema</b></td>\n            <td>{{msg.payload.sistema_activo ? '✅ Activo' : '⛔ Inactivo'}}</td>\n        </tr>\n        <tr>\n            <td><b>Sensor ID</b></td>\n            <td>{{msg.payload.sistema_id}}</td>\n        </tr>\n    </table>\n</div>",
