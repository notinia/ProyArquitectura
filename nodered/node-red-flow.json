    {
        "id": "40bc89e19800ecfa",
        "type": "function",
        "z": "5306dc40c5a9c0a0",
        "name": "Guardar Globales",
        "func": "if (msg.payload.umbral_mm !== undefined) global.set('umbral_mm', Number(msg.payload.umbral_mm));\nif (msg.payload.sistema_activo !== undefined) global.set('sistema_activo', msg.payload.sistema_activo);\nif (msg.payload.email_alertas !== undefined) global.set('email_alertas', msg.payload.email_alertas);\nif (msg.payload.sistema_id !== undefined) global.set('sistema_id', msg.payload.sistema_id);\nreturn msg;",
        "outputs": 1,
        "x": 650,
        "y": 340,
        "wires": [
            []
        ]
    },
    {
        "id": "0e7dacf036fd3222",
        "type": "function",
        "z": "5306dc40c5a9c0a0",
        "name": "Motor de Reglas",
        "func": "const dist = Number(msg.payload);\nif (isNaN(dist)) return null;\n\nconst umbral = global.get(\"umbral_mm\") || 200;\nconst activo = global.get(\"sistema_activo\");\nconst emailDest = (global.get(\"email_alertas\") || \"\").trim() || \"admin@ejemplo.com\";\n\nif (activo === false || activo === \"false\") return [null, null];\n\nconst alerta = (dist <= umbral) ? 1 : 0;\n\n// Salida 1: POST a la Base de Datos\nconst msgDB = {\n    payload: {\n        distancia_mm: dist,\n        alerta: alerta,\n        sensor_id: global.get(\"sistema_id\") || \"SENSOR-01\"\n    }\n};\n\n// Salida 2: Enviar Alerta\nlet msgAlerta = null;\nif (alerta === 1) {\n    msgAlerta = {\n        topic: \"⚠️ Alerta de proximidad ToF\",\n        to:    String(emailDest),          // force string, never undefined\n        from:  \"tof@caece.edu.ar\",         // required by some SMTP servers\n        payload: \"\\nSe detectó un objeto a \" + dist + \" mm.\\n\\n\" +\n                \"Umbral configurado: \" + umbral + \" mm.\\n\" +\n                \"Hora del sistema: \" + new Date().toLocaleString() + \"\\n\\n\" +\n                \"Sistema CAECE ToF Orchestrator.\"\n    };\n}\n\nreturn [msgDB, msgAlerta];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 460,
        "wires": [
            [
                "0cb87e948bd37a1b",
                "c315f40a9e5929e9"
            ],
