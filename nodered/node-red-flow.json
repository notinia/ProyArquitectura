    {
        "id": "c315f40a9e5929e9",
        "type": "function",
        "z": "5306dc40c5a9c0a0",
        "name": "Color Alerta",
        "func": "const dist = msg.payload.distancia_mm;\nconst umbral = global.get(\"umbral_mm\") || 200;\nconst alerta = dist <= umbral;\n\nmsg.payload = {\n    distancia: dist,\n    umbral: umbral,\n    alerta: alerta\n};\n\nreturn msg;",
