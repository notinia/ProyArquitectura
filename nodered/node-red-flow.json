        "name": "Widget Alerta",
        "order": 4,
        "width": 0,
        "height": 0,
        "format": "<div ng-if=\"msg\" style=\"\n    text-align: center;\n    padding: 16px;\n    border-radius: 8px;\n    font-size: 1.4em;\n    font-weight: bold;\n    background-color: {{msg.payload.alerta ? '#ff4444' : '#44bb44'}};\n    color: white;\n\">\n    <span ng-if=\"msg.payload.alerta\">⚠️ ALERTA</span>\n    <span ng-if=\"!msg.payload.alerta\">✅ OK</span>\n    <br/>\n    <span style=\"font-size:0.8em\">\n        {{msg.payload.distancia}} mm — umbral {{msg.payload.umbral}} mm\n    </span>\n</div>",
